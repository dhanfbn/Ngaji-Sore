# Google Sheets API Configuration
# Get your API key from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_SHEETS_API_KEY=

# ID of the Google Spreadsheet to use as data source
# The Spreadsheet ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/[THIS PART]/edit
SPREADSHEET_ID=

# Authentication Session
# A secret string used to encrypt/decrypt session cookies
SESSION_SECRET=

# Supabase Postgres — Tahap 1 migration
# DATABASE_URL: Transaction pooler (PgBouncer, port 6543) — used by the app's Prisma Client adapter at runtime (src/lib/prisma.ts).
# DIRECT_URL: Direct connection (port 5432) — used only by the Prisma CLI (migrate/generate), see prisma7.config.ts.
# Get both from Supabase project settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Tahap 2 — one-time guru password seed (scripts/seed-guru-passwords.ts)
# Only needed transiently when running the seed script; not read by the app itself.
GURU_DEFAULT_PASSWORD=
